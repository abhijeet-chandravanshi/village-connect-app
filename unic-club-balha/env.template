# ===========================================
# UNIC Club Frontend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# API Configuration
# Local development
VITE_API_URL=http://localhost:8080/api

# Production (uncomment and update when deploying)
# VITE_API_URL=https://your-backend-domain.railway.app/api

# ===========================================
# Firebase Configuration (for Phone Auth OTP)
# ===========================================
# Get these from Firebase Console > Project Settings > Your Apps > Web App
# https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Enable Firebase Phone Auth (set to 'true' for free OTP via Firebase)
# Set to 'false' to use backend OTP (requires SMS service like Twilio)
VITE_USE_FIREBASE_AUTH=true

# ===========================================
# Optional: App Configuration
# ===========================================
VITE_APP_NAME=UNIC Club Balha
VITE_DEFAULT_LANGUAGE=hi
